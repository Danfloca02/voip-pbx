# Transporte SIP de cada maquina (IP anunciada, redes locales, certificados).
# Se crea copiando pjsip_local.conf.example. Ver docs/DESPLIEGUE.md
config/etc/asterisk/pjsip_local.conf

# Red del contenedor en la laptop de desarrollo (bridge + ports).
# Se crea copiando compose.override.yaml.example. En el servidor NO debe existir.
compose.override.yaml

# Certificados TLS: se generan por maquina, nunca se versionan.
config/etc/asterisk/keys/

# Artefactos
build.log
*.pcap
*.pcapng

# Logs y CDR de Asterisk. Los subdirectorios cdr-csv/ y cdr-custom/ los crea
# 'make logdirs' en cada arranque: si faltan, el CDR falla.
logs/

# Ficheros temporales de editor
*.swp
*.swo
*~
