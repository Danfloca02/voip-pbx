# SOLO para desarrollo en Windows con Docker Desktop.
# En el servidor Linux de entrega este fichero NO debe existir: sin el manda
# el 'network_mode: host' de compose.yaml, que es la configuracion objetivo.
#
#     cp compose.override.yaml.example compose.override.yaml
#
# Motivo: 'host' no funciona en Docker Desktop. El motor corre en su propia VM
# ('docker-desktop'), asi que seria la red de ESA VM, ni Windows ni WSL.
# Asterisk arranca, escucha, y no lo alcanza nadie: el softphone se queda en
# "connecting" para siempre.
#
# Coste de usar bridge: se pierde la IP de origen (todo llega como 172.17.0.1),
# asi que 'type=identify' no sirve y hay que usar la variante B de la troncal.
# Ver docs/DESPLIEGUE.md §3 y §4.
services:
  app:
    network_mode: bridge
    ports:
      - "5060:5060/udp"
      - "5061:5061/tcp"
      - "10000-10020:10000-10020/udp"
