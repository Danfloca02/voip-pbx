; Transporte SIP. UNICO fichero que cambia entre maquinas: no se versiona.
;   cp pjsip_local.conf.example pjsip_local.conf
; Guia: docs/DESPLIEGUE.md

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
; MI direccion, la que ven los demas. Nunca la del otro extremo.
;   LAN          -> IP de esta maquina        (ipconfig / ip -br addr)
;   IP publica   -> IP publica                (curl -4 ifconfig.me)
;   Tras NAT     -> IP publica del router + port forwarding
external_media_address=CAMBIAR_IP
external_signaling_address=CAMBIAR_IP
; Redes propias: dentro anuncia la IP privada, fuera la de external_*.
; Necesario para atender LAN e internet a la vez.
; DESCOMENTAR solo con network_mode: host. En bridge anunciaria 172.17.0.x.
;local_net=192.168.0.0/24

[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
cert_file=/etc/asterisk/keys/asterisk.crt
priv_key_file=/etc/asterisk/keys/asterisk.key
method=tlsv1_2
; Mismas direcciones que el transporte UDP.
external_media_address=CAMBIAR_IP
external_signaling_address=CAMBIAR_IP
;local_net=192.168.0.0/24
